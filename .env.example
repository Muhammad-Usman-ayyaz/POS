# ==========================================
# Pesticide Club Shop ERP - Root Environment Variables Example
# Copy this file to .env or use separate frontend/.env and backend/.env
# ==========================================

# --- BACKEND SETTINGS ---
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=pesticide_erp_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration (Comma separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=1

# --- FRONTEND SETTINGS ---
VITE_API_URL=http://localhost:8000/api
